{
  "name": "zx-spectrum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "author": "Terence Ang (motionfxdesign)",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@zx-spectrum/app",
    "build": "npm run build --workspace=@zx-spectrum/core && npm run build --workspace=@zx-spectrum/worker && npm run build --workspace=@zx-spectrum/app && npm run build --workspace=@zx-spectrum/mcp-server",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cpu-exerciser": "vitest run packages/core/src/cpu/zexdoc.test.ts",
    "typecheck": "tsc -b",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
